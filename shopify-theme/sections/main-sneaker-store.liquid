{{ 'sneaker-store.css' | asset_url | stylesheet_tag }}
<section class="sneaker-store">
  <div class="announcement"><span>COMPLIMENTARY SHIPPING ON ORDERS OVER $100</span><span>BUILT TO MOVE <span aria-hidden="true">↗</span></span></div>
  <header class="site-header">
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">{{ shop.name | default: 'STRIDE' | escape }}<span>®</span></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/collections/new-arrivals">NEW DROP</a><a href="/collections/men">MEN</a><a href="/collections/women">WOMEN</a><a class="sale-link" href="/collections/sale">SALE</a>
    </nav>
    <div class="header-actions"><a href="{{ routes.search_url }}" aria-label="Search">SEARCH</a><a href="{{ routes.account_url }}">ACCOUNT</a><a href="{{ routes.cart_url }}">BAG <span class="bag-count">{{ cart.item_count }}</span></a><button class="menu-toggle" type="button" aria-label="Toggle menu" aria-expanded="false">☰</button></div>
  </header>
  <main id="MainContent">
    <section class="hero">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span class="status-dot"></span>{{ section.settings.eyebrow | escape }}</p>
        <h1>{{ section.settings.headline | default: 'ENGINEERED FOR MOVEMENT' | escape }}</h1>
        <p class="hero-description">{{ section.settings.description | escape }}</p>
        <div class="hero-actions"><a class="button button-dark" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label | default: 'Shop the collection' | escape }} <span>↗</span></a><a class="text-link" href="{{ section.settings.secondary_link | default: '#technology' }}">{{ section.settings.secondary_label | default: 'Explore technology' | escape }} <span>↗</span></a></div>
        <div class="hero-meta"><span>01 / 04</span><span>DESIGNED FOR EVERYDAY DISTANCE</span></div>
      </div>
      <div class="hero-art" data-tilt>
        <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
        <div class="hero-glow"></div>
        <div class="hero-tag tag-top">STRIDE / 001</div>
        <img class="hero-shoe" src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1400&q=90" alt="Sculptural red performance sneaker" fetchpriority="high">
        <div class="hero-tag tag-bottom"><span>ENERGY RETURN</span><strong>+24%</strong></div>
        <span class="art-index">S / 01</span>
      </div>
      <div class="hero-bottom"><span>RUN YOUR OWN ROUTE</span><span class="scroll-cue">SCROLL TO EXPLORE ↓</span><span>DESIGNED IN MOTION</span></div>
    </section>
    <section class="category-strip" aria-label="Shop by category">
      <a href="/collections/running" class="category-card category-running"><span class="category-number">01</span><span class="category-title">RUNNING</span><span class="category-arrow">↗</span><span class="category-sub">Go further, feel less.</span></a>
      <a href="/collections/lifestyle" class="category-card category-life"><span class="category-number">02</span><span class="category-title">LIFESTYLE</span><span class="category-arrow">↗</span><span class="category-sub">Everyday, elevated.</span></a>
      <a href="/collections/performance" class="category-card category-performance"><span class="category-number">03</span><span class="category-title">PERFORMANCE</span><span class="category-arrow">↗</span><span class="category-sub">Made to push limits.</span></a>
    </section>
    <section class="products-section" id="shop">
      <div class="section-heading reveal"><div><p class="eyebrow">THE ROTATION / 2026</p><h2>Find your <em>stride.</em></h2></div><a class="text-link" href="/collections/all">VIEW ALL PRODUCTS ↗</a></div>
      {% assign featured_collection = section.settings.collection %}
      {% if featured_collection == blank or collections[featured_collection] == blank %}{% assign featured_collection = collections.all %}{% else %}{% assign featured_collection = collections[featured_collection] %}{% endif %}
      <div class="product-grid">
        {% for product in featured_collection.products limit: 4 %}
          <article class="product-card reveal">
            <a class="product-image-wrap" href="{{ product.url }}">
              {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="900">{% else %}<div class="product-placeholder">STRIDE</div>{% endif %}
              {% if product.compare_at_price > product.price %}<span class="product-badge">SALE</span>{% else %}<span class="product-badge">NEW SEASON</span>{% endif %}
              <span class="quick-view">VIEW PRODUCT ↗</span>
            </a>
            <div class="product-info"><div><a class="product-title" href="{{ product.url }}">{{ product.title | escape }}</a><p class="product-type">{{ product.type | default: 'Performance footwear' | escape }}</p></div><span class="product-price">{{ product.price | money }}</span></div>
            {% if product.available %}<form method="post" action="{{ routes.cart_add_url }}" class="quick-add"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button type="submit">QUICK ADD <span>+</span></button></form>{% else %}<p class="sold-out">SOLD OUT</p>{% endif %}
          </article>
        {% else %}
          {% for n in (1..4) %}
            <article class="product-card reveal"><a class="product-image-wrap demo-product demo-{{ n }}" href="/collections/all"><span class="product-badge">COMING INTO FOCUS</span><img src="{% case n %}{% when 1 %}https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=900&q=85{% when 2 %}https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=900&q=85{% when 3 %}https://images.unsplash.com/photo-1495555961986-6d4c1ecb7be3?auto=format&fit=crop&w=900&q=85{% else %}https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=900&q=85{% endcase %}" alt="Sneaker product preview" loading="lazy"><span class="quick-view">EXPLORE ↗</span></a><div class="product-info"><div><a class="product-title" href="/collections/all">{% case n %}{% when 1 %}Velocity One{% when 2 %}Pulse Runner{% when 3 %}Cloud Form{% else %}Street Form 02{% endcase %}</a><p class="product-type">Performance / Everyday</p></div><span class="product-price">$ {{ 120 | plus: n | times: 1 }}.00</span></div><a class="quick-add" href="/collections/all">DISCOVER STYLE <span>↗</span></a></article>
          {% endfor %}
        {% endfor %}
      </div>
    </section>
    <section class="tech-section" id="technology"><div class="tech-visual"><div class="tech-ring"></div><img src="https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=1100&q=90" alt="Close-up of modern sneaker construction" loading="lazy"></div><div class="tech-copy reveal"><p class="eyebrow">THE SCIENCE OF STRIDE</p><h2>More than a shoe.<br><em>A feeling.</em></h2><p>Responsive cushioning, considered materials, and a silhouette built around the way you move. Every detail has a reason.</p><div class="tech-points"><div><span>01</span><strong>ENERGY FOAM</strong><small>Responsive comfort with every step.</small></div><div><span>02</span><strong>BREATHABLE KNIT</strong><small>Lightweight support that moves with you.</small></div><div><span>03</span><strong>GRIP OUTSOLE</strong><small>Confident traction from street to studio.</small></div></div><a class="button button-light" href="/collections/all">MEET YOUR NEXT PAIR ↗</a></div></section>
    <section class="newsletter"><p class="eyebrow">GET IN THE LOOP</p><h2>First access. <em>Fresh drops.</em></h2><p>New releases, limited colourways, and stories made for movement.</p>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="newsletter-email">Email address</label><input id="newsletter-email" type="email" name="contact[email]" placeholder="Your email address" required><button type="submit" aria-label="Subscribe">JOIN US ↗</button>{% if form.posted_successfully? %}<p class="form-success">You're on the list. Welcome.</p>{% endif %}{% if form.errors %}<div class="form-error">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</section>
  </main>
  <footer class="site-footer"><a class="wordmark" href="{{ routes.root_url }}">{{ shop.name | default: 'STRIDE' | escape }}<span>®</span></a><p>MADE FOR WHERE YOU'RE GOING.</p><div><a href="/policies/privacy-policy">PRIVACY</a><a href="/policies/refund-policy">RETURNS</a><a href="/pages/contact">CONTACT</a></div><small>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. KEEP MOVING.</small></footer>
</section>
{% schema %}
{
  "name": "3D sneaker storefront",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"THE NEXT STEP"},
    {"type":"text","id":"headline","label":"Hero headline","default":"ENGINEERED FOR MOVEMENT"},
    {"type":"textarea","id":"description","label":"Hero description","default":"Light on your feet. Loud in every direction. Meet the next generation of everyday performance."},
    {"type":"text","id":"button_label","label":"Primary button label","default":"Shop the collection"},
    {"type":"url","id":"button_link","label":"Primary button link"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"Explore the details"},
    {"type":"url","id":"secondary_link","label":"Secondary button link"},
    {"type":"collection","id":"collection","label":"Featured collection"}
  ],
  "presets": [{"name":"3D sneaker storefront"}]
}
{% endschema %}